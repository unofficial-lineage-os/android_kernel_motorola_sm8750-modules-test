# leap: under kernel.mk nothing sets ANDROID_BUILD_TOP; keep the remaining layout paths inside the source tree
ifeq ($(ANDROID_BUILD_TOP),)
ANDROID_BUILD_TOP := $(srctree)/..
endif
# add -Wall to try to catch everything we can.
EXTRA_CFLAGS += -Wall
EXTRA_CFLAGS += -I$(srctree)/../sm8750-modules/motorola/include

prod_list := hawao penang pnangn
find_target := $(foreach find, $(prod_list), $(findstring $(find), $(TARGET_PRODUCT)))
find_target := $(strip $(find_target))
$(warning find_target=$(find_target))
ifneq ($(find_target),)
$(warning define SUPPORT_POWER_GPIO)
EXTRA_CFLAGS += -DSUPPORT_POWER_GPIO
endif

obj-m += fpsensor_spi_tee.o
