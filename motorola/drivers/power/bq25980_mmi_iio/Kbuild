		-I$(srctree)/../sm8750-modules/motorola/drivers/power/bq25980_mmi_iio

ifneq ($(filter m y,$(CONFIG_MMI_BQ25980_BULK_READ)),)
        EXTRA_CFLAGS += -DCONFIG_MMI_BQ25980_BULK_READ
endif

obj-m += bq25980_mmi_iio.o
