# leap: under kernel.mk nothing sets ANDROID_BUILD_TOP; keep the remaining layout paths inside the source tree
ifeq ($(ANDROID_BUILD_TOP),)
ANDROID_BUILD_TOP := $(srctree)/..
endif
# add -Wall to try to catch everything we can.
EXTRA_CFLAGS += -Wall
EXTRA_CFLAGS += -I$(TOP)/motorola/kernel/modules/include

ifneq ($(filter m y,$(CONFIG_USE_MMI_CHARGER)),)
	EXTRA_CFLAGS += -DUSE_MMI_CHARGER
	EXTRA_CFLAGS += -I$(srctree)/../sm8750-modules/motorola/drivers/power/mmi_charger
	KBUILD_EXTRA_SYMBOLS += $(CURDIR)/$(KBUILD_EXTMOD)/../mmi_charger/$(GKI_OBJ_MODULE_DIR)/Module.symvers
endif

ifneq ($(filter m y,$(CONFIG_USE_MMI_GLINK_CHARGER)),)
	EXTRA_CFLAGS += -DUSE_MMI_GLINK_CHARGER
	EXTRA_CFLAGS += -I$(srctree)/../sm8750-modules/motorola/drivers/power/mmi_glink_charger
	KBUILD_EXTRA_SYMBOLS += $(CURDIR)/$(KBUILD_EXTMOD)/../mmi_glink_charger/$(GKI_OBJ_MODULE_DIR)/Module.symvers
endif

ifneq ($(filter m y, $(ADAPTIVE_TOLERANCE_OPTIMIZATION)),)
	EXTRA_CFLAGS += -DADAPTIVE_TOLERANCE_OPTIMIZATION
endif

obj-m += qpnp_adaptive_charge.o
