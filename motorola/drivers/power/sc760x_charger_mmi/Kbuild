# leap: under kernel.mk nothing sets ANDROID_BUILD_TOP; keep the remaining layout paths inside the source tree
ifeq ($(ANDROID_BUILD_TOP),)
ANDROID_BUILD_TOP := $(srctree)/..
endif
# add -Wall to try to catch everything we can.
EXTRA_CFLAGS += -Wall
EXTRA_CFLAGS += -I$(srctree)/../sm8750-modules/motorola/include \
		-I$(srctree)/../sm8750-modules/motorola/drivers/power/sc760x_charger_mmi \
		-I$(srctree)/../sm8750-modules/motorola/drivers/power/mmi_charger

ifneq ($(filter m y,$(CONFIG_THERMAL_RATIO_CONTROL)),)
	EXTRA_CFLAGS += -DTHERMAL_RATIO_CONTROL
endif

obj-m += sc760x_charger_mmi.o

KBUILD_EXTRA_SYMBOLS += $(CURDIR)/$(KBUILD_EXTMOD)/../mmi_charger/$(GKI_OBJ_MODULE_DIR)/Module.symvers
