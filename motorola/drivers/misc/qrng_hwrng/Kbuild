EXTRA_CFLAGS += -DCONFIG_HW_RANDOM_IDQ250C2_TIMER
EXTRA_CFLAGS += -DCONFIG_HW_RANDOM_IDQ250C2_MISC_DEVICE

obj-m += qrng_hwrng.o
