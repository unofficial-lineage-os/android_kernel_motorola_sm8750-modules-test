# leap: under kernel.mk nothing sets ANDROID_BUILD_TOP; keep the remaining layout paths inside the source tree
ifeq ($(ANDROID_BUILD_TOP),)
ANDROID_BUILD_TOP := $(srctree)/..
endif
# add -Wall to try to catch everything we can.
EXTRA_CFLAGS += -Wall
EXTRA_CFLAGS += -I$(srctree)/../sm8750-modules/motorola/include \
		-I$(srctree)/../sm8750-modules/motorola/drivers/misc/awinic/aw862x_haptic_nv

ifneq (,$(filter kobe%, $(TARGET_PRODUCT)))
       EXTRA_CFLAGS += -DFCNT_VIBRATION
       EXTRA_CFLAGS += -DAW_UEFI_F0_CALIBRATION
endif

ifneq (,$(filter kobe, $(TARGET_PRODUCT)))
       EXTRA_CFLAGS += -DCONFIG_AF_NOISE_ELIMINATION
endif

obj-m += aw862x_haptic_nv.o

aw862x_haptic_nv-objs += haptic_nv.o
aw862x_haptic_nv-objs += aw862xx.o
aw862x_haptic_nv-objs += aw8623x.o
aw862x_haptic_nv-objs += aw8624.o

